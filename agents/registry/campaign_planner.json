              "name": {
                "type": "string"
              },
              "campaign_type": {
                "type": "string"
              },
              "target_industry": {
                "type": "string"
              },
              "target_region": {
                "type": "string"
              },
              "offer": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["draft"]
              },
              "requires_approval": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "campaign_type",
              "target_industry",
              "target_region",
              "offer",
              "status",
              "requires_approval"
            ]
          },
