{
  "info": {
    "name": "ABM Agents API",
    "description": "REST API for 5 ABM Agents — Persona Classifier, Message Strategy, Email Copy, WhatsApp Copy, LinkedIn Copy",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/token/",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "token", ""]
            }
          },
          "response": []
        }
      ]
    },
    {
