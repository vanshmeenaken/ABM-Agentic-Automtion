              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"VP of Sales\",\n  \"company_type\": \"SaaS\",\n  \"industry\": \"EdTech\",\n  \"seniority_signals\": [\"manages 10+ people\", \"5+ years experience\"]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/agents/persona-classifier/classify/",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "agents", "persona-classifier", "classify", ""]
            }
          },
          "response": []
        },
        {
          "name": "Get Persona Classifier Docs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
